# Public URL where this service is reachable. Do not include a trailing slash.
APP_BASE_URL=https://chat.example.com

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN_SECRET=replace-with-a-64-character-random-secret

# Resend API key and an address/domain verified in Resend.
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=VComingle <no-reply@mail.example.com>

# Optional email-verification controls (defaults shown).
EMAIL_VERIFICATION_TTL_MS=86400000
EMAIL_VERIFICATION_RESEND_COOLDOWN_MS=60000
